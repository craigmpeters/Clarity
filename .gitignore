# -----------------------------------------------------------------------------
# Standard Swift / Xcode .gitignore
# -----------------------------------------------------------------------------
# This file tells Git which files and directories should not be tracked.
# Keep the repository clean of personal settings, build artifacts, and
# tool-generated files that are not part of the source code.
#
# Generated from the GitHub "Swift" template with Xcode-specific additions.
# -----------------------------------------------------------------------------

# =============================================================================
# macOS
# =============================================================================
# General macOS metadata files that should never be committed.
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails and metadata generated by the Finder.
._*

# Files that might appear in the root of a volume.
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share.
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# =============================================================================
# Xcode
# =============================================================================
# User-specific state and settings. These are personal to each developer and
# should not be shared.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside

# User-specific workspace and scheme data.
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
docs

# Autogenerated scheme management files.
xcschememanagement.plist

# Build artifacts and intermediates. These are recreated by Xcode on every build.
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
*.DSYM

# Playgrounds
# Xcode Playgrounds save timeline and compiled output here.
timeline.xctimeline
playground.xcworkspace

# =============================================================================
# Swift Package Manager
# =============================================================================
# SwiftPM builds, dependencies, and package resolution state.
# Packages/          # Legacy SwiftPM dependency location.
# Package.pins       # Legacy SwiftPM pin configuration.
# Package.resolved   # The resolved versions of SwiftPM dependencies. Some
#                    # teams choose to commit this for reproducible builds;
#                    # uncomment the line below if you want it ignored.
.build/
.swiftpm/

# =============================================================================
# CocoaPods
# =============================================================================
# CocoaPods downloads dependencies into the Pods/ directory. If you use
# CocoaPods, you usually want to ignore the Pods folder while keeping the
# Podfile.lock in version control for reproducible builds. Uncomment the line
# below if you are using CocoaPods and want to ignore Pods/.
#
# Pods/

# Podfile.lock is typically kept so that everyone installs the same versions.
# If you prefer not to track it, uncomment the next line.
#
# Podfile.lock

# =============================================================================
# Carthage
# =============================================================================
# Carthage downloads and builds dependencies. The Carthage/Build folder is
# derived data that should be rebuilt on each machine. Uncomment the line
# below if you use Carthage.
#
# Carthage/Build/
# Carthage/Checkouts/

# =============================================================================
# Accio / Dependency managers
# =============================================================================
# Accio dependency manager generated directories. Uncomment if used.
#
# Dependencies/
# .accio/

# =============================================================================
# fastlane
# =============================================================================
# fastlane automates deployment. It can store sensitive data and screenshots.
# It is safe to keep the Fastfile and Appfile in source control; ignore the
# rest. Uncomment the lines below if you use fastlane.
#
# fastlane/report.xml
# fastlane/Preview.html
# fastlane/screenshots/**/*.png
# fastlane/test_output
# fastlane/readme.md

# =============================================================================
# Code Injection
# =============================================================================
# InjectionIII / Injection for Xcode temporary files.
# iOSInjectionProject/

# =============================================================================
# App Thinning / Archives
# =============================================================================
# Archive and export results are derived from source code.
*.xcarchive
*.app

# =============================================================================
# Local tooling
# =============================================================================
# Editor and tool-specific swap files.
*.swp
*.swo
*~

# JetBrains / AppCode project metadata.
.idea/

# VS Code workspace settings (uncomment if you prefer to ignore them).
# .vscode/

# -----------------------------------------------------------------------------
# End of .gitignore
# -----------------------------------------------------------------------------
